rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidUsername(u) {
      return u is string && u.matches('^[a-z0-9_]{3,24}$');
    }

    // Public user profile & public ECDH P-256 identity key (SPKI base64)
    // Private keys and plaintext passwords are NEVER stored in Firestore.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['uid', 'username', 'displayName', 'publicKey', 'online', 'lastSeen'])
        && request.resource.data.uid == uid
        && isValidUsername(request.resource.data.username)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.publicKey is string
        && request.resource.data.publicKey.size() <= 512;

      allow update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username == resource.data.username;

      allow delete: if false;
    }

    // Username reservation index for atomic uniqueness checks
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidUsername(username)
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Private FCM device tokens isolated from public user profile
    match /userTokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 1-to-1 Conversations: conversationId = sorted(uidA, uidB).join("_")
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      function willBeParticipant() {
        return isSignedIn()
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.auth.uid in request.resource.data.participants;
      }

      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if willBeParticipant();
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      // Encrypted messages subcollection: ONLY ciphertext + IV + metadata allowed
      match /messages/{messageId} {
        function parentConvo() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function isConvoMember() {
          return isSignedIn() && request.auth.uid in parentConvo().participants;
        }

        allow read: if isConvoMember();

        allow create: if isConvoMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() > 0
          && request.resource.data.ciphertext.size() <= 16384
          && request.resource.data.iv is string
          && request.resource.data.iv.size() <= 64
          && request.resource.data.clientMsgId is string
          && !('plaintext' in request.resource.data);

        // Recipient can only update delivery/read receipt status
        allow update: if isConvoMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt', 'readAt'])
          && request.resource.data.status in ['DELIVERED', 'READ'];

        allow delete: if false;
      }
    }
  }
}
